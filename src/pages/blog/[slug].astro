---
// [TG-DESC]: Dynamic Blog Post Route & TG SEO Master Entity Injection
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// The SEO Spine: Master Entity Graph + Software Application + Article Schema
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `https://www.thetradersgazette.com/blog/${entry.slug}#article`,
      "headline": entry.data.title,
      "datePublished": new Date(entry.data.date).toISOString(),
      "description": entry.data.summary,
      "author": { "@id": "https://www.thetradersgazette.com/#organization" },
      "publisher": { "@id": "https://www.thetradersgazette.com/#organization" },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://www.thetradersgazette.com/blog/${entry.slug}`
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.thetradersgazette.com/#terminal",
      "name": "The Trader's Gazette Terminal",
      "alternateName": "TG Terminal",
      "description": "A market intelligence and trading systems platform designed for traders and investors who operate with structure, discipline, and intent...",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "url": "https://app.thetradersgazette.com",
      "author": { "@id": "https://www.thetradersgazette.com/#organization" }
    },
    {
      "@type": "Organization",
      "@id": "https://www.thetradersgazette.com/#organization",
      "name": "The Trader's Gazette",
      "url": "https://www.thetradersgazette.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://raw.githubusercontent.com/Ozz310/tradersgazetteterminal/refs/heads/main/images/WhatsApp%20Image%202025-06-18%20at%2011.37.16.jpeg",
        "width": 112,
        "height": 112
      },
      "founder": {
        "@type": "Person",
        "name": "Mohammad Osama",
        "sameAs": "http://www.linkedin.com/in/mohammad-osama-4247729b"
      },
      "sameAs": [
        "https://www.facebook.com/share/1M8F5rxTWr/",
        "https://www.instagram.com/thetradersgazette?igsh=bnQzaWE4YzlmZXVp",
        "http://www.youtube.com/@TheTradersGazette",
        "http://www.linkedin.com/in/mohammad-osama-4247729b"
      ]
    }
  ]
};
---

<Layout title={`${entry.data.title} | TG Terminal`} description={entry.data.summary}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    
    <article class="container mx-auto px-4 py-16 max-w-4xl">
        <header class="mb-12 border-b border-gray-800 pb-8 text-center">
            <time class="text-[#DDAA33] font-mono tracking-widest text-sm uppercase mb-4 block">{entry.data.date}</time>
            <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-6">{entry.data.title}</h1>
            <p class="text-xl text-gray-400 italic font-serif">{entry.data.summary}</p>
        </header>

        <div class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-a:text-[#DDAA33] hover:prose-a:text-yellow-400 prose-img:rounded-xl prose-img:border prose-img:border-gray-800 mx-auto">
            <Content />
        </div>
        
        <div class="mt-16 pt-8 border-t border-gray-800 text-center">
             <a href="/auth/register" class="inline-block bg-[#DDAA33] text-black font-extrabold text-lg py-4 px-10 rounded-lg shadow-xl hover:bg-yellow-500 transition-all duration-300">
                Execute With Intent: Access TG Terminal
            </a>
        </div>
    </article>
</Layout>
