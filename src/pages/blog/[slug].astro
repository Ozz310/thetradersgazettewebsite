---
// [TG-DESC]: Dynamic Blog Post Route & SEO Schema Injection
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// The SEO Spine: Knowledge Graph Injection
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "datePublished": new Date(entry.data.date).toISOString(),
  "author": {
    "@type": "Organization",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "TG Terminal",
    "logo": {
      "@type": "ImageObject",
      "url": "https://thetradersgazette.com/logo_tg.jpeg"
    }
  },
  "description": entry.data.summary
};
---

<Layout title={`${entry.data.title} | TG Terminal`} description={entry.data.summary}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    
    <article class="container mx-auto px-4 py-16 max-w-4xl">
        <header class="mb-12 border-b border-gray-800 pb-8 text-center">
            <time class="text-[#DDAA33] font-mono tracking-widest text-sm uppercase mb-4 block">{entry.data.date}</time>
            <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-6">{entry.data.title}</h1>
            <p class="text-xl text-gray-400 italic font-serif">{entry.data.summary}</p>
        </header>

        <div class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-a:text-[#DDAA33] hover:prose-a:text-yellow-400 prose-img:rounded-xl prose-img:shadow-2xl mx-auto">
            <Content />
        </div>
        
        <div class="mt-16 pt-8 border-t border-gray-800 text-center">
             <a href="/auth/register" class="inline-block bg-[#DDAA33] text-black font-extrabold text-lg py-4 px-10 rounded-lg shadow-xl hover:bg-yellow-500 transition-all duration-300">
                Execute With Intent: Access TG Terminal
            </a>
        </div>
    </article>
</Layout>
